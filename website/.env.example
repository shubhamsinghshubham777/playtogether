# ==========================================
# PlayTogether Website — Environment Variables
# ==========================================

# Supabase (same project as the desktop/mobile Flutter app)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public Site URL for OAuth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paddle (International Checkout & Subscriptions)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_client_token_here
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_MONTHLY_PRICE_ID=pri_monthly_xxx
PADDLE_ANNUAL_PRICE_ID=pri_annual_xxx
PADDLE_API_KEY=pdl_apikey_xxx

# Razorpay (India Prepaid Passes)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=rzp_secret_xxx
RAZORPAY_PLAN_1MO_AMOUNT=14900
RAZORPAY_PLAN_12MO_AMOUNT=99900

# PostHog Analytics (optional — omit to disable)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
