# ==========================================
# PlayTogether Website — Environment Variables
# ==========================================

# Supabase (same project as the desktop/mobile Flutter app)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public Site URL for OAuth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paddle (International Checkout & Subscriptions)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_client_token_here
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID=pri_monthly_xxx
NEXT_PUBLIC_PADDLE_ANNUAL_PRICE_ID=pri_annual_xxx
PADDLE_API_KEY=pdl_apikey_xxx
PADDLE_WEBHOOK_SECRET_KEY=pdl_ntfset_xxx
SUPABASE_SERVICE_ROLE_KEY=ey...

# PostHog Analytics (optional — omit to disable)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
