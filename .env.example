# ==============================================================================
# SyncTogether Client Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to `.env` in the repository root before building or running.
# NOTE: Client-safe values ONLY. This file is bundled inside the Flutter app.
# Server secrets must NEVER be added here (use supabase/functions/.env instead).
# ==============================================================================

# Supabase Production / Self-Hosted Backend (Required)
# Cloud: https://<project-ref>.supabase.co
# Self-Hosted: https://api.yourdomain.com (or LAN IP)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Local Development Fallbacks (Optional)
# Debug builds (`flutter run`) automatically prefer these when set.
# Release builds ignore them entirely and use SUPABASE_URL above.
# - Desktop/Web: http://127.0.0.1:54321
# - Android Emulator: http://10.0.2.2:54321
# - Physical Mobile Device on LAN: http://192.168.x.x:54321
SUPABASE_URL_LOCAL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY_LOCAL=sb_publishable_xxxxx

# LiveKit Audio/Video Mesh (Optional)
# Enables voice facecam tiles and 360p video facecams.
# Cloud: wss://<subdomain>.livekit.cloud
# Self-Hosted: ws://127.0.0.1:7880 or wss://livekit.yourdomain.com
# If omitted or empty, AV facecam features are gracefully hidden.
LIVEKIT_URL=wss://xxxxx.livekit.cloud

# Cloudflare Turnstile Captcha (Optional)
# Protects anonymous guest account creation against bot floods.
# For local dev testing, use Turnstile's test key: 1x00000000000000000000AA
TURNSTILE_SITE_KEY=0x4AAAAAA...

# Sentry Crash Reporting (Optional)
# Write-only public client DSN for crash reports. Disabled when omitted.
SENTRY_DSN=https://xxxxx@o0000000.ingest.sentry.io/0000000

# PostHog Product Telemetry (Optional)
# Write-only public project key. Disabled when omitted.
POSTHOG_API_KEY=phc_xxxxx
# PostHog Host: defaults to https://us.i.posthog.com (use https://eu.i.posthog.com or self-hosted endpoint)
POSTHOG_HOST=https://us.i.posthog.com
