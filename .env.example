SUPABASE_URL=xxxxx
SUPABASE_PUBLISHABLE_KEY=xxxxx
# Debug builds use these instead, so `flutter run` never points at the project
# real users are on. Omit them and debug falls back to the production values
# above. Release builds ignore them entirely, so CI needs nothing here.
# `supabase start` prints both; the URL is the API URL. On an Android emulator
# use http://10.0.2.2:54321, and on a physical device your machine's LAN IP.
SUPABASE_URL_LOCAL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY_LOCAL=sb_publishable_xxxxx
LIVEKIT_URL=wss://xxxxx.livekit.cloud
TURNSTILE_SITE_KEY=0x4AAA...
SENTRY_DSN=https://xxxxx@o0000000.ingest.de.sentry.io/0000000
# A PostHog project API key is public and write-only by design, like the Sentry
# DSN above — never a personal or server key. Omit it and analytics is disabled.
POSTHOG_API_KEY=phc_xxxxx
# Only for EU or self-hosted projects; defaults to https://us.i.posthog.com.
POSTHOG_HOST=https://eu.i.posthog.com
