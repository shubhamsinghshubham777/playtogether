SUPABASE_URL=xxxxx
SUPABASE_PUBLISHABLE_KEY=xxxxx
LIVEKIT_URL=wss://xxxxx.livekit.cloud
TURNSTILE_SITE_KEY=0x4AAA...
SENTRY_DSN=https://xxxxx@o0000000.ingest.de.sentry.io/0000000
# A PostHog project API key is public and write-only by design, like the Sentry
# DSN above — never a personal or server key. Omit it and analytics is disabled.
POSTHOG_API_KEY=phc_xxxxx
# Only for EU or self-hosted projects; defaults to https://us.i.posthog.com.
POSTHOG_HOST=https://eu.i.posthog.com
