# ==============================================================================
# Supabase Server & Auth Configuration
# ------------------------------------------------------------------------------
# Server-side secrets used by `supabase config push` or local container auth.
# ==============================================================================

# Google OAuth (Optional — for Google sign-in)
# Create a Web OAuth client in Google Cloud Console.
# Authorized Redirect: https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=GOCSPX-xxxxx

# Cloudflare Turnstile Secret Key (Optional — for guest captcha verification)
# For local dev testing, use Turnstile's test secret: 1x0000000000000000000000000000000AA
SUPABASE_AUTH_CAPTCHA_SECRET=0x4AAAAAA...

# Cloudflare R2 / S3 Storage (Optional — for media sharing)
CF_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY_ID=xxxxx
CF_R2_SECRET_ACCESS_KEY=xxxxx
CF_R2_BUCKET_NAME=synctogether-media
