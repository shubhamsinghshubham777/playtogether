# ==============================================================================
# Supabase Edge Functions Secrets
# ------------------------------------------------------------------------------
# Set in Supabase Cloud via:
#   supabase secrets set --env-file supabase/functions/.env
# Or loaded locally via:
#   supabase functions serve --env-file supabase/functions/.env
# ==============================================================================

# LiveKit SFU (Required for livekit-token function)
# Cloud: wss://<subdomain>.livekit.cloud
# Self-Hosted: ws://127.0.0.1:7880 or wss://livekit.yourdomain.com
# Keys must match the keys declared in your LiveKit server configuration.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_dev_key_for_synctogether_change_in_production
LIVEKIT_URL=wss://xxxxx.livekit.cloud

# Cloudflare R2 / S3 Storage (Optional — for media-share & cleanup-r2 functions)
CF_R2_ENDPOINT=https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>
CF_R2_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>
CF_R2_BUCKET_NAME=synctogether-media
